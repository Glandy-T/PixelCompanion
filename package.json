{
  "name": "pixel-companion",
  "version": "0.1.0",
  "description": "A minimal Windows desktop pixel companion.",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win portable"
  },
  "keywords": [
    "electron",
    "desktop-pet",
    "pixel-companion"
  ],
  "author": "",
  "license": "UNLICENSED",
  "devDependencies": {
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "io.github.pixelcompanion.desktop",
    "productName": "PixelCompanion",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/characters/placeholder/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    }
  }
}
