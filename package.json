{
  "name": "pixel-companion",
  "version": "0.1.0",
  "description": "A minimal Windows desktop pixel companion.",
  "main": "src/main.js",
  "scripts": {
    "prestart": "node node_modules/electron/install.js",
    "start": "electron .",
    "prestart:3d": "node node_modules/electron/install.js",
    "start:3d": "electron . --3d",
    "test": "node --test test/*.test.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win portable"
  },
  "keywords": [
    "electron",
    "desktop-pet",
    "pixel-companion"
  ],
  "author": "",
  "license": "UNLICENSED",
  "devDependencies": {
    "electron": "^43.8.7",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "io.github.pixelcompanion.desktop",
    "productName": "PixelCompanion",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/characters/placeholder/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    }
  },
  "dependencies": {
    "three": "0.187.0"
  },
  "engines": {
    "node": ">=24"
  },
  "overrides": {
    "minimatch@>=7 <11.0.1": "11.0.5"
  }
}
